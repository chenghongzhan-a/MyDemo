#
# This .gitignore file should be placed into the root of your repository.
# Recommended for Unity projects: https://github.com/github/gitignore/blob/main/Unity.gitignore
#

# ========== Unity generated / cache ==========
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ========== Asset meta data should be tracked ==========
# 不要忽略 .meta 文件，它们必须提交！

# ========== IDE / editors ==========
.idea/
.vs/
*.csproj
*.sln

# ========== OS junk ==========
.DS_Store
Thumbs.db

# ========== Crashlytics ==========
crashlytics-build.properties

# ========== Autogenerated assets ==========
*.mat.sort
*.LightingBoxes
*.LightmapParameters
*.LightingPatterns

ExportedObj/
*.svd
*.unitypackage

# ========== Sensitive ==========
*.p12
*.key
# ========== Temp scripts ==========
_fix.py
fix.ps1
fix3.py
